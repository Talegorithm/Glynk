# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=glynk
POSTGRES_PASSWORD=glynk
POSTGRES_DB=glynk

# Data storage
DATA_ROOT=/data/glynk

# Azure OpenAI (embedding)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01
EMBEDDING_MODEL=text-embedding-3-large

# Translation
TRANSLATION_ENABLED=true

# RSS
RSS_CHECK_INTERVAL_HOURS=24

# Aliyun (OSS 媒体 inbox + DashScope Qwen3-ASR，见 docs/modules/video-ingestion.md)
# —— 对应的代码默认：ALI_OSS_ENDPOINT/BUCKET 有默认值，key 必填 ——
ALI_API_KEY=                 # DashScope API key (sk-...)
ALI_ACCESS_KEY_ID=           # Aliyun Access Key ID (LTAI...)
ALI_ACCESS_KEY_SECRET=       # Aliyun Access Key Secret
# ALI_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com   # 默认已是这个
# ALI_OSS_BUCKET=qwen-transcribe                          # 默认已是这个
